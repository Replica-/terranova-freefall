{
    // The game traps integer divides by zero on purpose (port/core/divtrap.c), as the DOS game
    // did: gdb must pass SIGFPE on to it, or the game stops on the first one and seems frozen.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Terra Nova: Freefall (debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tnfree.exe",
            "preLaunchTask": "build tnfree",
            "args": [
                "--game", "D:\\Games\\Terra Nova Strike Force Centauri\\TN",
                "--cd", "D:\\Games\\Terra Nova Strike Force Centauri\\CD\\TNF108.cue"
            ],
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\usr\\bin\\gdb.exe",
            "symbolLoadInfo": { "loadAll": false, "exceptionList": "tnfree.exe" },
            "setupCommands": [
                { "description": "Pass divide traps to the game", "text": "handle SIGFPE nostop noprint pass" }
            ]
        },
        {
            "name": "Terra Nova: Freefall (start at mission 3)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tnfree.exe",
            "preLaunchTask": "build tnfree",
            "args": [
                "--game", "D:\\Games\\Terra Nova Strike Force Centauri\\TN",
                "--cd", "D:\\Games\\Terra Nova Strike Force Centauri\\CD\\TNF108.cue",
                "--mission", "3"
            ],
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\usr\\bin\\gdb.exe",
            "symbolLoadInfo": { "loadAll": false, "exceptionList": "tnfree.exe" },
            "setupCommands": [
                { "description": "Pass divide traps to the game", "text": "handle SIGFPE nostop noprint pass" }
            ]
        },
        {
            // no window, no sound: boots to the main menu, saves a screenshot every 3 s to
            // build/headless/shots and quits after 20 s.  Its own config and saves in build/headless.
            "name": "Headless: boot to menu (no audio)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tnfree.exe",
            "preLaunchTask": "build tnfree",
            "args": [
                "--user", "headless",
                "--game", "D:\\Games\\Terra Nova Strike Force Centauri\\TN",
                "--cd", "D:\\Games\\Terra Nova Strike Force Centauri\\CD\\TNF108.cue",
                "--music", "off"
            ],
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "SDL_VIDEO_DRIVER", "value": "offscreen" },
                { "name": "SDL_AUDIO_DRIVER", "value": "dummy" },
                { "name": "FREEFALL_SHOT", "value": "headless/shots/menu" },
                { "name": "FREEFALL_SHOT_EVERY", "value": "3000" },
                { "name": "FREEFALL_SCRIPT", "value": "3000:kEscape;5000:kEscape;7000:kEscape;9000:kEscape;20000:q" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\usr\\bin\\gdb.exe",
            "symbolLoadInfo": { "loadAll": false, "exceptionList": "tnfree.exe" },
            "setupCommands": [
                { "description": "Pass divide traps to the game", "text": "handle SIGFPE nostop noprint pass" }
            ]
        },
        {
            // no window, no sound: starts a random scenario (docs/PORTING.md), plays 15 s of it with
            // a screenshot every 5 s to build/headless/shots, then quits
            "name": "Headless: random scenario mission (no audio)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tnfree.exe",
            "preLaunchTask": "build tnfree",
            "args": [
                "--user", "headless",
                "--game", "D:\\Games\\Terra Nova Strike Force Centauri\\TN",
                "--cd", "D:\\Games\\Terra Nova Strike Force Centauri\\CD\\TNF108.cue",
                "--music", "off"
            ],
            "cwd": "${workspaceFolder}/build",
            "environment": [
                { "name": "SDL_VIDEO_DRIVER", "value": "offscreen" },
                { "name": "SDL_AUDIO_DRIVER", "value": "dummy" },
                { "name": "FREEFALL_SHOT", "value": "headless/shots/mission" },
                { "name": "FREEFALL_SHOT_EVERY", "value": "5000" },
                { "name": "FREEFALL_SCRIPT", "value": "3000:kEscape;5000:kEscape;7000:kEscape;9000:kEscape;11000:m450,370;11500:c;14000:m320,456;14500:c;18000:m510,444;18500:c;+15000:q" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\usr\\bin\\gdb.exe",
            "symbolLoadInfo": { "loadAll": false, "exceptionList": "tnfree.exe" },
            "setupCommands": [
                { "description": "Pass divide traps to the game", "text": "handle SIGFPE nostop noprint pass" }
            ]
        },
        {
            "name": "Terra Nova: Freefall (check data)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tnfree.exe",
            "preLaunchTask": "build tnfree",
            "args": [
                "--game", "D:\\Games\\Terra Nova Strike Force Centauri\\TN",
                "--check"
            ],
            "cwd": "${workspaceFolder}/build",
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\usr\\bin\\gdb.exe"
        }
    ],
    "inputs": [
        {
            "id": "mission",
            "type": "pickString",
            "description": "New Game starts the campaign at this mission (campaign order; dist/README.txt)",
